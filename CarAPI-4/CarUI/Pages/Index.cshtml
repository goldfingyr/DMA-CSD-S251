@page
@using UI.Pages
@model IndexModel
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <div class="col">
        <div id="ajax1date"></div>
    </div>
</div>
<div class="row">
    <div class="col"></div>
    <div class="col">
        @if (Model.CarSelected != null)
        {
            <h3>Selected car</h3>
            <p>@Model.CarSelected.licenseplate<br />@Model.CarSelected.make<br />@Model.CarSelected.model<br />@Model.CarSelected.color</p>
        }
        <h3>Find car</h3>
        <form method="post">
            <input type="text" name="target" />
            <input type="hidden" name="action" value="findCar" />
            <input type="submit" value="Submit" />
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function ajax1() {
            try {
                const response = await fetch('?handler=ajax1');

                if (!response.ok) {
                    throw new Error(`HTTP error ${response.status}`);
                }

                const data = await response.json();
                document.getElementById('ajax1date').textContent = data.message;
            }
            catch (error) {
                console.error(error);
                document.getElementById('ajax1date').textContent = 'Error';
            }
        }

        function functionInterval() {
            ajax1();
        }

        setInterval(functionInterval, 1000);
    </script>
}

