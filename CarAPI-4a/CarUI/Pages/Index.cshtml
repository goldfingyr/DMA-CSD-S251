@page
@using UI.Pages
@model IndexModel
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <div class="col">
        <div id="ajax1date"></div>
    </div>
</div>

<div class="row">
    <div class="col" style="background-color:red">
        <form method="POST">
            <input type="hidden" name="action" value="findCar" />
            <input type="text" name="target" />
            <br />
            <input type="submit" value="Find Car" />
        </form>
        @if (Model.CarSelected != null)
        {
            @Model.CarSelected.licenseplate <br />
            @Model.CarSelected.make <br />
            @Model.CarSelected.model <br />
            @Model.CarSelected.color <br />
        }
    </div>
    <div class="col" style="background-color:yellow">
        <form method="POST">
            <input type="hidden" name="action" value="findCarByColor" />
            <input type="text" name="target" />
            <br />
            <input type="submit" value="Find Car by Color" />
        </form>
        @if (Model.Cars != null)
        {
            foreach (var car in Model.Cars)
            {
                @car.licenseplate <br />
                @car.make <br />
                @car.model <br />
                @car.color <br />
                <hr />
            }
        }
    </div>
    <div class="col" style="background-color:lightblue">
        <form method="POST">
            <input type="hidden" name="action" value="datepick" />
            <input type="text" name="daterange" value="01/11/2026 - 01/12/2026" />
            <br />
            <input type="submit" value="Date Pick" />
        </form>
        @if (Model.Cars != null)
        {
            foreach (var car in Model.Cars)
            {
                @car.licenseplate <br />
                @car.make <br />
                @car.model <br />
                @car.color <br />
                <hr />
            }
        }
    </div>
</div>





@section Scripts {
    <script>
        async function ajax1() {
            try {
                const response = await fetch('?handler=ajax1');

                if (!response.ok) {
                    throw new Error(`HTTP error ${response.status}`);
                }

                const data = await response.json();
                document.getElementById('ajax1date').textContent = data.message;
            }
            catch (error) {
                console.error(error);
                document.getElementById('ajax1date').textContent = 'Error';
            }
        }

        function functionInterval() {
            ajax1();
        }

        setInterval(functionInterval, 1000);

</script>

}

<script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

<script>
 $(function() {
    $('input[name="daterange"]').daterangepicker({
        opens: 'left’
        },
        function(start, end, label) {
            console.log("A new date selection was made: " + start.format('YYYY-MM-DD') + ' to ' + end.format('YYYY-MM-DD'));
        });
    });
</script>


@section head {
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
}
